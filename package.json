{
  "name": "miniapp",
  "displayName": "miniapp",
  "description": "小程序语言工具，支持 WXML 与 WXS 语义、自定义事件契约、跨文件重命名，以及脚本和样式源码导航。",
  "version": "0.0.2",
  "publisher": "miniprogramlab",
  "icon": "media/icon.png",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/MiniProgramLab/miniapp.git"
  },
  "homepage": "https://github.com/MiniProgramLab/miniapp#readme",
  "bugs": {
    "url": "https://github.com/MiniProgramLab/miniapp/issues"
  },
  "engines": {
    "vscode": "^1.96.0",
    "node": ">=22"
  },
  "packageManager": "pnpm@10.13.1",
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "miniapp",
    "miniprogram",
    "wxml",
    "微信小程序"
  ],
  "main": "./dist/extension.cjs",
  "types": "./dist/api/index.d.ts",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "workspaceContains:**/project.config.json",
    "onLanguage:json",
    "onLanguage:jsonc",
    "onLanguage:css",
    "onLanguage:scss",
    "onLanguage:less",
    "onLanguage:typescript",
    "onLanguage:javascript"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "dev:diagram": "node scripts/architecture.mjs",
    "dev:diagram:watch": "node scripts/architecture.mjs --watch",
    "dev:diagram:check": "node scripts/architecture.mjs --check",
    "dev:test:diagram": "node --test tests/architecture.test.mjs",
    "dev:check": "tsc --noEmit && node scripts/check-boundaries.mjs && node scripts/build.mjs && tsc -p tsconfig.api.json",
    "dev:test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "dev:bench": "node --import tsx scripts/benchmark.mts",
    "dev:metadata": "node --import tsx scripts/update-component-events.mts",
    "dev:test:host": "pnpm dev:check && node scripts/test-host.mjs",
    "dev:package": "pnpm dev:check && node scripts/package.mjs",
    "dev:release:check": "node scripts/check-release.mjs",
    "dev:cursor": "pnpm dev:package && node scripts/install-cursor.mjs",
    "vscode:prepublish": "pnpm dev:check"
  },
  "dependencies": {
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/vscode": "1.96.0",
    "@vscode/vsce": "^4.0.0",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "ovsx": "1.3.0",
    "tsx": "^4.23.15"
  },
  "contributes": {
    "typescriptServerPlugins": [
      {
        "name": "@miniprogramlab/style-imports",
        "enableForWorkspaceTypeScriptVersions": true
      }
    ],
    "languages": [
      {
        "id": "wxml",
        "aliases": [
          "WXML",
          "wxml"
        ],
        "extensions": [
          ".wxml"
        ],
        "configuration": "./src/languages/wxml/resources/language-configuration.json"
      },
      {
        "id": "wxss",
        "aliases": [
          "WXSS",
          "wxss"
        ],
        "extensions": [
          ".wxss"
        ],
        "configuration": "./src/languages/css/resources/language-configuration.json"
      },
      {
        "id": "wxs",
        "aliases": [
          "WXS",
          "wxs"
        ],
        "extensions": [
          ".wxs"
        ],
        "configuration": "./src/languages/typescript/resources/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "wxml",
        "scopeName": "text.html.wxml",
        "path": "./src/languages/wxml/resources/wxml.tmLanguage.json",
        "embeddedLanguages": {
          "source.ts.embedded.wxml": "typescript"
        }
      },
      {
        "language": "wxss",
        "scopeName": "source.css.wxss",
        "path": "./src/languages/css/resources/wxss.tmLanguage.json"
      },
      {
        "language": "wxs",
        "scopeName": "source.wxs",
        "path": "./src/languages/typescript/resources/wxs.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "wxml",
        "path": "./src/languages/wxml/resources/snippets.json"
      }
    ],
    "configurationDefaults": {
      "[wxml]": {
        "editor.linkedEditing": true,
        "editor.quickSuggestions": {
          "strings": "on"
        }
      }
    },
    "configuration": {
      "title": "miniapp",
      "properties": {
        "miniprogramlab.miniapp.wxml.autoClosingTags": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "输入 > 后自动闭合 WXML 标签，接受新标签补全时插入完整标签对。"
        },
        "miniprogramlab.miniapp.wxml.customData": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "scope": "resource",
          "description": "工作区相对的组件库 Custom Data JSON 文件；支持标签、属性、枚举值和小程序事件及版本扩展，最多读取三十二份文件。"
        },
        "miniprogramlab.miniapp.checks.include": {
          "type": "array", "items": { "type": "string" }, "default": ["**/*.{wxml,wxs,ts,tsx,js,jsx,mts,cts,mjs,cjs,json,jsonc}"], "scope": "resource",
          "description": "工作区检查包含的文件模式，使用编辑器原生 glob。"
        },
        "miniprogramlab.miniapp.checks.exclude": {
          "type": "array", "items": { "type": "string" }, "default": ["**/node_modules/**", "**/dist/**", "**/build/**", "**/.git/**", "**/.pnpm-store/**"], "scope": "resource",
          "description": "工作区检查排除的目录与文件模式；依赖解析仍可按需读取这些文件。"
        },
        "miniprogramlab.miniapp.checks.maxFiles": {
          "type": "integer", "default": 10000, "minimum": 1, "maximum": 100000, "scope": "resource",
          "description": "工作区检查的文件数量上限，超过时报告未完成，保留已检查结果。"
        },
        "miniprogramlab.miniapp.checks.maxFindings": {
          "type": "integer", "default": 50000, "minimum": 1, "maximum": 100000, "scope": "resource",
          "description": "工作区检查结果数量上限，超过时报告未完成。"
        },
        "miniprogramlab.miniapp.wxml.sdkVersion": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "兼容性检查的目标基础库版本；留空读取最近项目配置的 libVersion，latest 或未知版本不产生版本诊断。"
        },
        "miniprogramlab.miniapp.wxml.maxTemplateFiles": {
          "type": "integer",
          "default": 500,
          "minimum": 1,
          "maximum": 2000,
          "scope": "resource",
          "description": "独立 WXML 模板调用图的文件数量上限，限定当前工作区并排除依赖及构建目录。"
        },
        "miniprogramlab.miniapp.wxml.maxScriptFiles": {
          "type": "integer",
          "default": 400,
          "minimum": 1,
          "maximum": 1000,
          "scope": "resource",
          "description": "单次 WXML 脚本引用链解析的文件数量上限，包含类型声明和标准库。"
        },
        "miniprogramlab.miniapp.wxml.maxRenameFiles": {
          "type": "integer",
          "default": 5000,
          "minimum": 100,
          "maximum": 10000,
          "scope": "resource",
          "description": "跨文件重命名的源码扫描数量上限，超出时停止生成编辑，避免遗漏引用。"
        },
        "miniprogramlab.miniapp.wxml.sourceRoot": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "组件源码根目录，相对当前工作区；默认向上查找最近的 app.json 或 app.config.ts/js。"
        },
        "miniprogramlab.miniapp.wxml.includePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "组件额外搜索根目录，相对当前工作区，用于静态复制目录中的组件实现。"
        },
        "miniprogramlab.miniapp.css.sourceRoot": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "小程序源码根目录，相对当前工作区；默认向上查找最近的 app.json 或 app.config.ts/js。"
        },
        "miniprogramlab.miniapp.css.includePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "额外样式导入搜索目录，相对当前工作区。"
        },
        "miniprogramlab.miniapp.css.maxFiles": {
          "type": "integer",
          "default": 300,
          "minimum": 1,
          "maximum": 2000,
          "scope": "resource",
          "description": "单次样式引用链解析的文件数量上限。"
        },
        "miniprogramlab.miniapp.wxml.adapters": {
          "type": "array",
          "default": [],
          "scope": "resource",
          "description": "按导入模块、导出符号和配置字段路径适配声明宏，不执行工程代码。",
          "items": {
            "type": "object",
            "required": [
              "name",
              "kind"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "实际导出符号名，导入别名仍可识别。"
              },
              "module": {
                "type": "string",
                "description": "限定 import 或 require 的模块名称；留空按符号名匹配。"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "page",
                  "component",
                  "behavior"
                ]
              },
              "argument": {
                "type": "integer",
                "minimum": 0,
                "maximum": 16,
                "default": 0
              },
              "data": {
                "type": "string",
                "description": "配置中的字段路径，点号表示嵌套，单独的 . 表示配置对象本身。"
              },
              "properties": {
                "type": "string",
                "description": "配置中的字段路径，点号表示嵌套，单独的 . 表示配置对象本身。"
              },
              "methods": {
                "type": "string",
                "description": "配置中的字段路径，点号表示嵌套，单独的 . 表示配置对象本身。"
              },
              "setup": {
                "type": "string",
                "description": "配置中的字段路径，点号表示嵌套，单独的 . 表示配置对象本身。"
              },
              "config": {
                "type": "string",
                "description": "配置中的字段路径，点号表示嵌套，单独的 . 表示配置对象本身。"
              },
              "components": {
                "type": "string",
                "description": "配置中的字段路径，点号表示嵌套，单独的 . 表示配置对象本身。"
              },
              "query": {
                "type": "string",
                "description": "页面查询参数 schema 的字段路径，支持构造器及 type/value/required 描述。"
              }
            }
          }
        }
      }
    },
    "commands": [
      { "command": "miniprogramlab.miniapp.checkWorkspace", "title": "检查工作区", "category": "miniapp" },
      { "command": "miniprogramlab.miniapp.cancelWorkspaceCheck", "title": "取消工作区检查", "category": "miniapp" },
      { "command": "miniprogramlab.miniapp.filterCheckResults", "title": "筛选检查结果", "category": "miniapp" },
      { "command": "miniprogramlab.miniapp.exportCheckReport", "title": "导出检查结果", "category": "miniapp" },
      {
        "command": "miniprogramlab.miniapp.explainNavigation",
        "title": "说明当前导航结果",
        "category": "miniapp"
      },
      {
        "command": "miniprogramlab.miniapp.showPlugins",
        "title": "查看已注册的语言插件",
        "category": "miniapp"
      },
      {
        "command": "miniprogramlab.miniapp.switchRelatedFile",
        "title": "切换关联文件",
        "category": "miniapp"
      },
      {
        "command": "miniprogramlab.miniapp.switchTemplate",
        "title": "切换到模板",
        "category": "miniapp"
      },
      {
        "command": "miniprogramlab.miniapp.switchScript",
        "title": "切换到脚本",
        "category": "miniapp"
      },
      {
        "command": "miniprogramlab.miniapp.switchStyle",
        "title": "切换到样式",
        "category": "miniapp"
      },
      {
        "command": "miniprogramlab.miniapp.switchConfiguration",
        "title": "切换到配置",
        "category": "miniapp"
      }
    ],
    "menus": {
      "explorer/context": [
        { "command": "miniprogramlab.miniapp.checkWorkspace", "when": "explorerResourceIsFolder", "group": "miniapp" }
      ]
    },
    "keybindings": [
      {
        "command": "miniprogramlab.miniapp.switchRelatedFile",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o",
        "when": "editorTextFocus && resourceExtname =~ /\\.(wxml|[cm]?[jt]sx?|wxs|wxss|scss|less|css|jsonc?)$/"
      }
    ]
  }
}
