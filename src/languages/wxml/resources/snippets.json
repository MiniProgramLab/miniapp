{
  "循环节点": {
    "prefix": "wxfor",
    "body": [
      "<view wx:for=\"{{${1:items}}}\" wx:key=\"${2:id}\">",
      "  $0",
      "</view>"
    ],
    "description": "带稳定键的循环节点"
  },
  "条件节点": {
    "prefix": "wxif",
    "body": [
      "<view wx:if=\"{{${1:visible}}}\">",
      "  $0",
      "</view>"
    ],
    "description": "条件渲染节点"
  },
  "视图容器": {
    "prefix": "wxmlview",
    "body": [
      "<view class=\"${1:container}\">",
      "  $0",
      "</view>"
    ],
    "description": "基础视图容器"
  }
}
